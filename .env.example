# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-generate-a-new-secret-key-for-production
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Database Configuration (For Production)
# DATABASE_URL=postgres://user:password@hostname:port/dbname

# Email Configuration (Gmail SMTP example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=CareBridge <no-reply@carebridge.com>

# Security Settings (Set to True in production)
SECURE_SSL_REDIRECT=False

# Logging
DJANGO_LOG_LEVEL=INFO

# Billing & Payment
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
