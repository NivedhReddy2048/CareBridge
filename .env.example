# ====================================================
# CareBridge Enterprise Production Environment Variables
# ====================================================

# 1. Core Django Configuration
DEBUG=False
SECRET_KEY=your_secure_60_character_random_string
ALLOWED_HOSTS=api.yourdomain.com,app.yourdomain.com
RENDER_EXTERNAL_HOSTNAME=api.yourdomain.com

# 2. Database (PostgreSQL)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# 3. Redis & Celery Orchestration
REDIS_URL=redis://user:password@hostname:6379/0

# 4. Storage Security (AWS S3 S3Bucket)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your_s3_bucket_name
AWS_S3_REGION_NAME=us-east-1

# 5. Third-Party Integrations
GEMINI_API_KEY=your_google_gemini_pro_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
SENTRY_DSN=https://your_sentry_dsn

# 6. Email Delivery
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=CareBridge <no-reply@carebridge.com>

# 7. Logging & Telemetry
DJANGO_LOG_LEVEL=INFO
