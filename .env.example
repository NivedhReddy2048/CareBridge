# CareBridge Enterprise - Environment Template
# Duplicate this file to .env and configure for your local/production environment

# ==========================================
# DJANGO CORE SETTINGS
# ==========================================
# Determines if the application runs in development (True) or production (False)
DEBUG=True

# Cryptographically secure random string (Generate a new one for production, at least 50 chars)
SECRET_KEY=django-insecure-example-key-replace-this-for-production-deployment

# Comma-separated list of allowed hostnames (e.g., carebridge.com, www.carebridge.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# DATABASE & CACHE
# ==========================================
# PostgreSQL connection string (Format: postgres://user:password@host:port/dbname)
DATABASE_URL=postgres://dummy:dummy@localhost:5432/dummy

# Redis connection string (Used for Cache, Celery Broker, and Channels Layer)
REDIS_URL=redis://localhost:6379/1

# ==========================================
# AI ENGINE CONFIGURATION
# ==========================================
# Google Gemini Pro / Flash API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# STORAGE (AWS S3)
# ==========================================
# AWS Credentials for HIPAA-compliant secure file storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# ==========================================
# OBSERVABILITY & MONITORING
# ==========================================
# Sentry DSN for error tracking in production
SENTRY_DSN=

# ==========================================
# INFRASTRUCTURE DEPLOYMENT (RENDER)
# ==========================================
# Hostname automatically provided by Render (Used for CSRF/CORS validation)
RENDER_EXTERNAL_HOSTNAME=

# ==========================================
# EMAIL SETTINGS
# ==========================================
# SMTP Configuration for transactional emails
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@carebridge.com

# ==========================================
# PAYMENT GATEWAY (RAZORPAY)
# ==========================================
# Razorpay API credentials for billing processing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
